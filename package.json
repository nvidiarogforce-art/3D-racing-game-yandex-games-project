{
  "name": "apex-horizon-racing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:yandex": "npm run typecheck && vite build --mode yandex",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package:yandex": "npm run build:yandex && node scripts/package.mjs"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "@types/three": "^0.185.0",
    "fflate": "^0.8.2",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
